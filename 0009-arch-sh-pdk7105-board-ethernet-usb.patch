-	return platform_add_devices(pdk7105_devices,
-				    ARRAY_SIZE(pdk7105_devices));
+	/* USB: power both ports, then program the STBus protocol wrappers.
+	 * u-boot has already configured the PHYs/clocking. */
+	stx7105_usb_power(0, 1);
+	stx7105_usb_power(1, 1);
+	pdk7105_usb_setup(STX7105_USB0_WRAPPER, STX7105_USB0_PROTOCOL, "usb0");
+	pdk7105_usb_setup(STX7105_USB1_WRAPPER, STX7105_USB1_PROTOCOL, "usb1");
