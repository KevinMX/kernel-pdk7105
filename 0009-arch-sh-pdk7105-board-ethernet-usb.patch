+/* Power up a USB port and init its AHB2STBUS wrapper.  This MUST happen
+ * before the controller registers are first read - with the block still
+ * unpowered/unclocked, STBus register reads hang the CPU. */
+static void __init pdk7105_usb_setup(unsigned long wrapper_paddr,
+				     unsigned long protocol_paddr,
+				     const char *name)
+{
+	unsigned long wrapper = (unsigned long)ioremap(wrapper_paddr, 0x100);
+	unsigned long protocol = (unsigned long)ioremap(protocol_paddr, 0x100);
+	int ret;
+
+	if (!wrapper || !protocol)
+		return;
+	ret = stx7105_usb_wrapper_init(wrapper, protocol);
+	if (ret)
+		printk(KERN_WARNING "PDK7105: %s AHB2STBUS wrapper init "
+		       "timed out (%d), port disabled\n", name, ret);
+}
+
