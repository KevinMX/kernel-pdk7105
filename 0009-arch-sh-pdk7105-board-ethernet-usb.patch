+/*
+ * MDC clock: the GMAC CSR clock is the 100 MHz IC interface clock.
+ * u-boot drives MDIO with CR=0 (clk/42, ~2.4 MHz); match that.
+ * clk_csr=0x20 sets the MAC_CSR_H_FRQ bit so
+ * stmmac_clk_csr_set() keeps our fixed value (its dynamic selection
+ * would use clk_rate==0 and pick /16 - 6.25 MHz, unreliable), while
+ * (0x20 << 2) & clk_csr_mask == 0 writes CR=0 into the MII address
+ * register, exactly like u-boot.
+ */
