+/* Board initialisation ---------------------------------------------------- */
+
+static void __init pdk7105_asc_pads(void)
+{
+	unsigned long pio4 = (unsigned long)ioremap(STX7105_PIO_BASE +
+						    4 * 0x1000, 0x100);
+	unsigned long pc0;
+	unsigned long cfg;
+
+	/* uart2_rxd/cts source select: PIO4.1 / PIO4.2 (SYSCFG[7] bits 1-2) */
+	cfg = __raw_readl(stx7105_sysconf + STX7105_SYSCFG(7));
+	cfg &= ~(0x3 << 1);
+	__raw_writel(cfg, stx7105_sysconf + STX7105_SYSCFG(7));
+
+	/* PIO4: pin0 TX alt-out(3), pin1 RX in(0), pin2 CTS in(0),
+	 * pin3 RTS alt-out(3) */
+	pc0 = __raw_readl(pio4 + PIO_PC(0));
+	pc0 &= ~0xff;
+	pc0 |= (3 << 0) | (0 << 2) | (0 << 4) | (3 << 6);
+	__raw_writel(pc0, pio4 + PIO_PC(0));
+}
+
+static void __init pdk7105_phy_reset_pin(void)
+{
+	unsigned long pio15 = (unsigned long)ioremap(STX7105_PIO_BASE +
+						     15 * 0x1000, 0x100);
+	unsigned long pc0;
+
+	/* PIO15.5 as output, drive low then high to reset the PHY */
+	pc0 = __raw_readl(pio15 + PIO_PC(0));
+	pc0 &= ~(0x3 << 10);
+	pc0 |= (1 << 10);		/* output */
+	__raw_writel(pc0, pio15 + PIO_PC(0));
+
+	__raw_writel(0, pio15 + PIO_POUT);
+	mdelay(100);
+	__raw_writel(1, pio15 + PIO_POUT);
+}
+
+static int __init pdk7105_devices_setup(void)
+{
+	/* USB0 (internal) and USB1 (external) power + wrapper init */
+	stx7105_usb_power(0, 1);
+	stx7105_usb_wrapper_init(STX7105_USB0_WRAPPER, STX7105_USB0_PROTOCOL);
+
+	stx7105_usb_power(1, 1);
+	stx7105_usb_wrapper_init(STX7105_USB1_WRAPPER, STX7105_USB1_PROTOCOL);
+
+	/* Provide the ASC console clock from the fixed peripheral clock */
+	clk_add_alias(NULL, "st-asc.0", "peripheral_clk", NULL);
+
+	return platform_add_devices(pdk7105_devices,
+				    ARRAY_SIZE(pdk7105_devices));
+}
+arch_initcall(pdk7105_devices_setup);
+
+static void __init pdk7105_setup(char **cmdline_p)
+{
+	printk("STMicroelectronics PDK7105 (NextVOD GB620) board initialisation\n");
+
+	stx7105_sysconf = ioremap(STX7105_SYSCONF_BASE, 0x900);
+
+	pdk7105_asc_pads();
+	pdk7105_phy_reset_pin();
+}
