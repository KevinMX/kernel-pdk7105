+/* SoC register bases (physical) ----------------------------------------- */
+
+#define STX7105_SYSCONF_BASE	0xfd000000	/* sysconf / ILC */
+#define STX7105_PIO_BASE	0xfd020000	/* PIO banks, +0x1000 each */
+#define STX7105_ASC2_BASE	0xfd032000	/* serial console (ASC2) */
+#define STX7105_GMAC_BASE	0xfd110000	/* STMAC ethernet */
+#define STX7105_USB0_WRAPPER	0xfe100000
+#define STX7105_USB0_EHCI	0xfe1ffe00
+#define STX7105_USB0_OHCI	0xfe1ffc00
+#define STX7105_USB0_PROTOCOL	0xfe1fff00
+#define STX7105_USB1_WRAPPER	0xfea00000
+#define STX7105_USB1_EHCI	0xfeaffe00
+#define STX7105_USB1_OHCI	0xfeaffc00
+#define STX7105_USB1_PROTOCOL	0xfeafff00
+
+/* sysconf register map: SYS_STA at +0x008, SYSCFG at +0x100, bank * 4 */
+#define STX7105_SYSCFG(reg)	(0x100 + 4 * (reg))
+#define STX7105_SYSSTAT(reg)	(0x008 + 4 * (reg))
+
+/* PIO register offsets */
+#define PIO_POUT		0x00
+#define PIO_SET_POUT		0x04
+#define PIO_CLR_POUT		0x08
+#define PIO_PIN			0x10
+#define PIO_PC(n)		(0x20 + 0x10 * (n))
+#define PIO_PCOMP		0x50
+
+static void __iomem *stx7105_sysconf;
+
+/* USB host power control (from stx7105_hispeed.c) ----------------------- */
+
+static void stx7105_usb_power(int port, int on)
+{
+	unsigned long cfg = (unsigned long)(stx7105_sysconf +
+			     STX7105_SYSCFG(32));
+	unsigned long sta = (unsigned long)(stx7105_sysconf +
+			     STX7105_SYSSTAT(15));
+	int pwr_bit = port ? 5 : 4;	/* USB_HOST_PWR */
+	int phy_bit = port ? 7 : 6;	/* USB_PHY_PWR */
+	int ack_bit = port ? 5 : 4;	/* USB_HOST_ACK */
+	int value = on ? 0 : 1;
+	unsigned long v;
+	int i;
+
+	v = __raw_readl(cfg);
+	if (value)
+		v |= (1 << pwr_bit) | (1 << phy_bit);
+	else
+		v &= ~((1 << pwr_bit) | (1 << phy_bit));
+	__raw_writel(v, cfg);
+
+	for (i = 5; i; --i) {
+		if (((__raw_readl(sta) >> ack_bit) & 1) == value)
+			break;
+		mdelay(10);
+	}
+}
+
+/* USB wrapper / STBus protocol init (from hcd-stm.c) --------------------- */
+
+#define AHB2STBUS_STBUS_OPC_OFFSET	0x00
+#define AHB2STBUS_MSGSIZE_OFFSET	0x04
+#define AHB2STBUS_CHUNKSIZE_OFFSET	0x08
+#define AHB2STBUS_STRAP_OFFSET		0x14
+#define AHB2STBUS_STRAP_16_BIT		0x04
+
+static void stx7105_usb_wrapper_init(unsigned long wrapper,
+				     unsigned long protocol)
+{
+	unsigned long req_reg;
+	unsigned long reg;
+
+	/* 8-bit PHY interface strap */
+	reg = __raw_readl(wrapper + AHB2STBUS_STRAP_OFFSET);
+	reg &= ~AHB2STBUS_STRAP_16_BIT;
+	__raw_writel(reg, wrapper + AHB2STBUS_STRAP_OFFSET);
+
+	/* STBus protocol: 32-bit opcode, 4-word messages, 4-packet chunks */
+	__raw_writel(3, protocol + AHB2STBUS_STBUS_OPC_OFFSET);
+	__raw_writel(2, protocol + AHB2STBUS_MSGSIZE_OFFSET);
+	__raw_writel(2, protocol + AHB2STBUS_CHUNKSIZE_OFFSET);
+
+	/* read-ahead on, opcode 5, threshold enable, 3 packets, threshold 7 */
+	req_reg = (1 << 21) | (5 << 16) | (1 << 14) | (3 << 9) | 7;
+	do {
+		__raw_writel(req_reg, protocol + AHB2STBUS_MSGSIZE_OFFSET);
+		reg = __raw_readl(protocol + AHB2STBUS_MSGSIZE_OFFSET);
+	} while ((reg & 0x7fffffff) != req_reg);
+}
