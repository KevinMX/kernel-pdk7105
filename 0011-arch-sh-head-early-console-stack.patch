+	 * ASC console mapping there.
 	 */
 	mov	#0, r1
-	mov	#NR_PMB_ENTRIES, r0
+	mov	#(NR_PMB_ENTRIES - 4), r0
 
 .Lagain:
 	mov.l	r1, @r3		/* Clear PMB_ADDR entry */
@@ -312,7 +386,7 @@
 	bf/s	9b		! while (r1 < r2)
 	 mov.l	r0,@-r2
 
-10:		
+10:
 #endif
 
 #ifdef CONFIG_OF_EARLY_FLATTREE
@@ -327,7 +401,8 @@
 	 nop
 
 	SYNCO()			! Wait for pending instructions..
-	
