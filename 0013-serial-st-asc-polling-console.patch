+/*
+ * Bring-up (pdk7105): poll the receive FIFO from a kernel thread so
+ * the console input works even when interrupt delivery is unavailable
+ * (the ST40 interrupt path is not yet fully trusted).  Runs alongside
+ * the interrupt handler when an IRQ is allocated; both paths are
+ * serialised by the port lock.
+ */
+static int asc_rx_poll(void *arg)
+{
+	struct uart_port *port = arg;
+	unsigned long flags;
+
+	for (;;) {
+		if (asc_in(port, ASC_STA) & ASC_STA_RBF) {
+			uart_port_lock_irqsave(port, &flags);
+			if (asc_in(port, ASC_STA) & ASC_STA_RBF)
+				asc_receive_chars(port);
+			uart_port_unlock_irqrestore(port, flags);
+		}
+
+		if (kthread_should_stop())
+			break;
+
+		schedule();
+	}
+
+	return 0;
+}
